# Server Environment Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/aurel_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/aurel_test?schema=public"

# Security & CORS Whitelist (comma-separated origins)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
SESSION_SECRET="development_session_secret_change_in_production_min_32_chars"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:4000/api/v1"
