# Server Environment Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/aurel_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/aurel_test?schema=public"

# Security & CORS Whitelist (comma-separated origins)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
SESSION_SECRET="development_session_secret_change_in_production_min_32_chars"
CSRF_SECRET="development_csrf_secret_change_in_production_min_32_chars"

# Reverse Proxy Trust Configuration
# Set to 'false' (default) when the application is directly exposed or in local development.
# Client IP will be derived authoritatively from the direct socket connection, ignoring spoofed X-Forwarded-* headers.
# Set to 'true' ONLY when running behind a trusted front-facing reverse proxy (e.g. AWS ALB, Nginx, Cloudflare)
# that strips or overwrites client-supplied X-Forwarded-For headers. When enabled, Express trusts 1 upstream hop.
# WARNING: Setting TRUST_PROXY=true without a sanitizing reverse proxy allows attackers to spoof client IPs and evade rate limits.
TRUST_PROXY=false

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:4000/api/v1"
